# Copy to .env and fill in. In Docker these come from deploy/.env instead.

# Required: the admin password (at least 12 characters).
ADMIN_PASSWORD=

# The public address, used to build ticket links. Leave empty locally.
PUBLIC_URL=

# The domain passkeys belong to (docs/deploying.md). Leave empty locally: passkeys
# then belong to localhost, so open http://localhost, never 127.0.0.1.
# Decide before inviting anyone: every passkey is tied to it for good.
WEBAUTHN_RP_ID=

# Where film folders live, and where the database is kept.
MEDIA_DIR=./media
DATA_DIR=./data

PORT=3000
