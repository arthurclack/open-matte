# Settings for running Open Matte on your computer with npm run dev: copy to
# .env and fill in. In Docker they come from deploy/.env instead
# (deploy/.env.example). A line starting with # leaves the setting at the
# default it shows.

# Required: the admin password, at least 12 characters.
ADMIN_PASSWORD=

# The site's public address, such as https://cinema.example.com, used to build
# ticket and setup links. Leave empty locally: links then use the address you
# opened the admin on.
PUBLIC_URL=

# The domain passkeys belong to (docs/installing.md, Choices you make once).
# Leave empty locally: passkeys then belong to localhost, so open
# http://localhost, never 127.0.0.1.
# On a server, decide before inviting anyone: every passkey is tied to it for good.
WEBAUTHN_RP_ID=

# Where film folders live, and where the database, posters and logo are kept.
MEDIA_DIR=./media
DATA_DIR=./data

# The port the server listens on.
PORT=3000

# Optional: a TMDB API key for film details and posters (docs/metadata.md).
# You can paste one in the admin under Settings instead; one set here wins.
TMDB_API_KEY=

# Daily backups: the folder ("off" turns them off), the hour they run (UTC),
# and how many to keep: the newest of each of the last BACKUP_KEEP_DAYS days,
# and the first of each of the last BACKUP_KEEP_MONTHS months.
# BACKUP_DIR=./data/backups
# BACKUP_HOUR=4
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MONTHS=12

# Optional: the folder an off-server copy of the backups lands in, as this
# machine sees it, so the admin's projection booth can show the newest copy.
# Only read, never written.
# BACKUP_COPY_DIR=

# How long a browser stays signed in: a viewer's or a person's (days), and the
# admin's (hours, counted from signing in).
# VIEWER_SESSION_DAYS=90
# ADMIN_SESSION_HOURS=12

# Rarely needed.
# Which proxies to believe about visitors' addresses, as Express's "trust proxy".
# The default suits Caddy in Docker. Don't leave it set but empty.
# TRUST_PROXY=loopback, uniquelocal
# Whether cookies are marked Secure: auto (when the request came over HTTPS),
# true or false.
# COOKIE_SECURE=auto
# Where the built web app is. npm run build writes it there.
# WEB_DIST=./dist
# production makes passkeys need PUBLIC_URL on https and WEBAUTHN_RP_ID. The
# Docker image sets it. Leave it unset locally.
# NODE_ENV=production
# TMDB's addresses, should you need to reach it through something else.
# TMDB_API_BASE=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
