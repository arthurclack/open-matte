# Caddy gets and renews the HTTPS certificate for $DOMAIN by itself.
# The domain's DNS must point at this server before the first start.
# REDIRECT_FROM (optional, in deploy/.env) lists other names, such as the bare
# domain, that are sent to $DOMAIN; Caddy gets certificates for those too.

{$DOMAIN} {$REDIRECT_FROM} {
	# Any name but DOMAIN goes to the same path on DOMAIN. Nothing is served
	# there, so a passkey ceremony can only ever run on DOMAIN itself.
	@elsewhere not host {$DOMAIN}
	redir @elsewhere https://{$DOMAIN}{uri} permanent

	# Compress pages and API responses. Video is already compressed.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/vnd.apple.mpegurl*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
