# Settings for Open Matte in Docker. Copy to deploy/.env on the server, fill in,
# and chmod 600 it. docs/installing.md explains each one.
# Docker Compose reads this file and treats $ as the start of a variable: put a
# value with $, # or a space in single quotes.

# Required: the address people visit, without https://, such as
# cinema.example.com. Its DNS must point at this server. Every link you send
# carries it, so choose one you'll keep.
DOMAIN=

# Optional: other names to send to DOMAIN, separated by spaces, such as the bare
# domain example.com when DOMAIN is www.example.com. Their DNS must point here too.
REDIRECT_FROM=

# The domain passkeys belong to: DOMAIN itself, or a parent of it such as
# example.com, which also covers a later move to another subdomain as long as
# every subdomain stays yours (docs/installing.md, Choices you make once).
# Decide before inviting anyone: every passkey is tied to it for good.
# Empty: the site works, but passkeys are off and the log says why.
WEBAUTHN_RP_ID=

# Required: the admin password, at least 12 characters. Make one with:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Optional: a TMDB API key for film details and posters (docs/metadata.md).
# You can paste one in the admin under Settings instead; one set here wins.
TMDB_API_KEY=

# Where the database, the film folders and the daily backups live on the server.
# Create the folders before the first start. Data and backups must be writable
# by uid 1000, the app's user in its container; the app only reads the media.
DATA_PATH=/srv/open-matte/data
MEDIA_PATH=/srv/open-matte/media
BACKUP_PATH=/srv/open-matte/backups

# Optional: when the daily backup runs (the hour in UTC, 0 to 23), and how many
# to keep: the newest of each of the last BACKUP_KEEP_DAYS days, and the first of
# each of the last BACKUP_KEEP_MONTHS months. Empty: 4, 14 and 12.
BACKUP_HOUR=
BACKUP_KEEP_DAYS=
BACKUP_KEEP_MONTHS=

# Optional: where the off-server copy of the backups appears inside the app's
# container, so the admin's projection booth can show the newest copy. The app
# only reads it. With the copy timer in deploy/systemd as shipped, which copies
# into the media folder, that is:
#   BACKUP_COPY_DIR=/media/.open-matte-backups
# A copy anywhere else needs mounting read-only in compose.override.yml first
# (docs/deploying.md, Keeping a copy off the server). Empty: no copy is shown.
BACKUP_COPY_DIR=

# The app reads a few more settings, listed in ../.env.example. Their defaults
# suit this setup. To change one, add it to the app's environment in
# compose.override.yml.
