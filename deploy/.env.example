# Copy to deploy/.env on the server and fill in.

# The address people visit, without https://. Its DNS must point at this server.
DOMAIN=cinema.example.com

# The admin password, at least 12 characters. Generate one with:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Optional: a TMDB API key for film information and posters (docs/metadata.md).
# You can also paste it in the admin under Settings instead.
TMDB_API_KEY=

# Where the database, the film folders and the daily backups live on the server.
# Create the backups folder before the first start, owned by uid 1000.
DATA_PATH=/srv/open-matte/data
MEDIA_PATH=/srv/open-matte/media
BACKUP_PATH=/srv/open-matte/backups
