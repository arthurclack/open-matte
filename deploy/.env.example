# Copy to deploy/.env on the server and fill in.

# The address people visit, without https://. Its DNS must point at this server.
DOMAIN=cinema.example.com

# Optional: other names to send to DOMAIN, separated by spaces, such as the bare
# domain when DOMAIN is www.example.com. Their DNS must point here too.
REDIRECT_FROM=

# The domain passkeys belong to: DOMAIN itself, or a parent of it such as
# example.com, which also covers a later move to another subdomain as long as
# every subdomain stays yours (docs/deploying.md, Passkeys).
# Decide before inviting anyone: every passkey is tied to it for good.
WEBAUTHN_RP_ID=

# The admin password, at least 12 characters. Generate one with:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Optional: a TMDB API key for film information and posters (docs/metadata.md).
# You can also paste it in the admin under Settings instead.
TMDB_API_KEY=

# Where the database, the film folders and the daily backups live on the server.
# Create the backups folder before the first start, owned by uid 1000.
DATA_PATH=/srv/open-matte/data
MEDIA_PATH=/srv/open-matte/media
BACKUP_PATH=/srv/open-matte/backups

# Optional: where the off-server copy of the backups lands, as the app's
# container sees it, so the admin's projection booth can show the newest copy.
# The app only reads it. With the copy timer in deploy/systemd, which copies
# into the media folder, that is:
#   BACKUP_COPY_DIR=/media/.open-matte-backups
# A copy anywhere else needs mounting read-only in compose.yml first
# (docs/deploying.md). Leave empty if you don't keep a copy the server can see.
BACKUP_COPY_DIR=
